  "nodes": [
    {"id":"b97c2101-1111-4f71-a001-000000000001","name":"Every minute","type":"n8n-nodes-base.scheduleTrigger","typeVersion":1.2,"position":[-760,0],"parameters":{"rule":{"interval":[{"field":"minutes","minutesInterval":1}]}}},
    {"id":"b97c2101-1111-4f71-a001-000000000002","name":"Get running campaigns","type":"n8n-nodes-base.httpRequest","typeVersion":4.5,"position":[-520,0],"parameters":{"url":"={{$env.OUTREACH_APP_URL}}/internal/campaigns/running","method":"GET","sendHeaders":true,"headerParameters":{"parameters":[{"name":"x-outreach-secret","value":"={{$env.OUTREACH_WEBHOOK_SECRET}}"}]},"options":{"timeout":10000}}},
    {"id":"b97c2101-1111-4f71-a001-000000000003","name":"Process campaign queue","type":"n8n-nodes-base.code","typeVersion":2,"position":[-280,0],"parameters":{"mode":"runOnceForEachItem","jsCode":"// Placeholder-safe dispatcher. The app endpoint returns at most one eligible lead per due campaign.\nconst campaign = $json;\nif (!campaign || !campaign.id || campaign.status !== 'running') return {json:{skip:true}};\nconst now = Date.now();\nif (campaign.endAt && now > Date.parse(campaign.endAt)) return {json:{campaignId:campaign.id,action:'complete'}};\nreturn {json:{campaignId:campaign.id,action:'next',instance:campaign.instance}};"}},
    {"id":"b97c2101-1111-4f71-a001-000000000004","name":"Get next eligible lead","type":"n8n-nodes-base.httpRequest","typeVersion":4.5,"position":[-40,0],"parameters":{"url":"={{$env.OUTREACH_APP_URL}}/internal/next","method":"POST","sendHeaders":true,"headerParameters":{"parameters":[{"name":"x-outreach-secret","value":"={{$env.OUTREACH_WEBHOOK_SECRET}}"}]},"sendBody":true,"specifyBody":"json","jsonBody":"={{JSON.stringify({campaignId:$json.campaignId})}}","options":{"timeout":10000}}},
    {"id":"b97c2101-1111-4f71-a001-000000000005","name":"Lead available?","type":"n8n-nodes-base.if","typeVersion":2.2,"position":[200,0],"parameters":{"conditions":{"options":{"caseSensitive":true,"typeValidation":"strict","version":2},"conditions":[{"id":"0f2b","leftValue":"={{Boolean($json.lead && $json.lead.id)}}","rightValue":true,"operator":{"type":"boolean","operation":"true","singleValue":true}}],"combinator":"and"},"options":{} }},
    {"id":"b97c2101-1111-4f71-a001-000000000006","name":"Send via Evolution API","type":"n8n-nodes-base.httpRequest","typeVersion":4.5,"position":[440,-100],"parameters":{"url":"={{$env.EVOLUTION_API_URL}}/message/sendText/{{$json.campaign.instance}}","method":"POST","sendHeaders":true,"headerParameters":{"parameters":[{"name":"apikey","value":"={{$env.EVOLUTION_API_KEY}}"}]},"sendBody":true,"specifyBody":"json","jsonBody":"={{JSON.stringify({number:$json.lead.phone.replace('+',''),textMessage:{text:$json.lead.message}})}}","options":{"timeout":20000,"response":{"response":{"fullResponse":true,"neverError":true}}}},"retryOnFail":false},
    {"id":"b97c2101-1111-4f71-a001-000000000007","name":"Mark sent","type":"n8n-nodes-base.httpRequest","typeVersion":4.5,"position":[680,-100],"parameters":{"url":"={{$env.OUTREACH_APP_URL}}/internal/mark-sent","method":"POST","sendHeaders":true,"headerParameters":{"parameters":[{"name":"x-outreach-secret","value":"={{$env.OUTREACH_WEBHOOK_SECRET}}"}]},"sendBody":true,"specifyBody":"json","jsonBody":"={{JSON.stringify({leadId:$('Get next eligible lead').item.json.lead.id,messageId:$json.body?.key?.id||$json.body?.message?.key?.id})}}","options":{"timeout":10000}}},
    {"id":"b97c2101-1111-4f71-a001-000000000008","name":"Evolution webhook","type":"n8n-nodes-base.webhook","typeVersion":2.1,"position":[-520,300],"webhookId":"a3c7ca3f-6c75-4ead-8a5a-e0d83c808602","parameters":{"httpMethod":"POST","path":"leadomi-evolution-events","responseMode":"onReceived","options":{}}},
    {"id":"b97c2101-1111-4f71-a001-000000000009","name":"Detect opt-out","type":"n8n-nodes-base.code","typeVersion":2,"position":[-280,300],"parameters":{"mode":"runOnceForEachItem","jsCode":"const body=$json.body||$json; const text=String(body.data?.message?.conversation||body.data?.message?.extendedTextMessage?.text||body.message?.conversation||'').trim().toLowerCase(); const fromMe=Boolean(body.data?.key?.fromMe||body.key?.fromMe); const raw=body.data?.key?.remoteJid||body.key?.remoteJid||''; const phone=raw.replace(/@s\\.whatsapp\\.net$/,'').replace(/[^0-9+]/g,''); const optout=/^(stop|unsubscribe|opt ?out|remove|quit|cancel|end)$/i.test(text); return {json:{phone,optout:optout&&!fromMe,reply:!fromMe&&!optout,text}};"}},
    {"id":"b97c2101-1111-4f71-a001-000000000010","name":"Is opt-out?","type":"n8n-nodes-base.if","typeVersion":2.2,"position":[-40,300],"parameters":{"conditions":{"options":{"caseSensitive":true,"typeValidation":"strict","version":2},"conditions":[{"id":"a1b2","leftValue":"={{$json.optout}}","rightValue":true,"operator":{"type":"boolean","operation":"true","singleValue":true}}],"combinator":"and"},"options":{}}},
    {"id":"b97c2101-1111-4f71-a001-000000000011","name":"Suppress opted-out number","type":"n8n-nodes-base.httpRequest","typeVersion":4.5,"position":[200,220],"parameters":{"url":"={{$env.OUTREACH_APP_URL}}/internal/suppress","method":"POST","sendHeaders":true,"headerParameters":{"parameters":[{"name":"x-outreach-secret","value":"={{$env.OUTREACH_WEBHOOK_SECRET}}"}]},"sendBody":true,"specifyBody":"json","jsonBody":"={{JSON.stringify({phone:$json.phone,reason:'WhatsApp opt-out'})}}","options":{"timeout":10000}}},
    {"id":"b97c2101-1111-4f71-a001-000000000012","name":"Record reply and stop follow-ups","type":"n8n-nodes-base.httpRequest","typeVersion":4.5,"position":[200,420],"parameters":{"url":"={{$env.OUTREACH_APP_URL}}/internal/reply","method":"POST","sendHeaders":true,"headerParameters":{"parameters":[{"name":"x-outreach-secret","value":"={{$env.OUTREACH_WEBHOOK_SECRET}}"}]},"sendBody":true,"specifyBody":"json","jsonBody":"={{JSON.stringify({phone:$json.phone,text:$json.text})}}","options":{"timeout":10000}}}
